      border: 1px solid rgba(94, 107, 155, 0.6);
    }

    .btn-outline:hover {
      background: rgba(94, 107, 155, 0.06);
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-muted);
      padding: 8px 12px;
      font-size: 13px;
    }

    .btn-ghost:hover {
      background: rgba(148, 163, 184, 0.12);
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 12px;
      color: var(--text-muted);
      align-items: center;
    }

    .hero-meta span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .hero-meta i {
      color: var(--accent-1);
    }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 10px;
    }

    .metric-chip {
      border-radius: 999px;
      border: 1px solid var(--border-soft);
      padding: 7px 10px;
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.9);
    }

    .metric-chip i {
      color: var(--accent-2);
    }

    .screen-main-right .card {
      min-height: 220px;
    }

    .rating-list {
      margin-top: 6px;
      font-size: 13px;
      color: var(--text-muted);
    }

    .rating-list-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      border-bottom: 1px dashed rgba(226, 228, 234, 0.8);
    }

    .rating-list-row:last-child {
      border-bottom: none;
    }

    .rating-badge {
      padding: 3px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .rating-badge-high {
      background: rgba(34, 197, 94, 0.12);
      color: #15803d;
    }

    .rating-badge-mid {
      background: rgba(59, 130, 246, 0.12);
      color: #1d4ed8;
    }

    .rating-badge-low {
      background: rgba(248, 113, 113, 0.12);
      color: #b91c1c;
    }

    .screen-analysis {
      flex-direction: column;
      gap: 18px;
    }

    .analysis-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }

    .analysis-title {
      font-size: 20px;
      font-weight: 600;
    }

    .analysis-subtitle {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 14px;
    }

    .input-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-bottom: 10px;
    }

    .input-wrapper {
      position: relative;
      flex: 1;
      min-width: 220px;
    }

    .input-wrapper i {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 13px;
    }

    .text-input {
      width: 100%;
      padding: 9px 11px 9px 30px;
      border-radius: 11px;
      border: 1px solid var(--border-soft);
      font-size: 14px;
      outline: none;
      transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
      background: rgba(255, 255, 255, 0.9);
    }

    .text-input:focus {
      border-color: rgba(94, 107, 155, 0.9);
      box-shadow: 0 0 0 1px rgba(94, 107, 155, 0.25);
      background: #ffffff;
    }

    .helper-text {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .loading-banner {
      display: none;
      margin-top: 10px;
      padding: 8px 10px;
      border-radius: 10px;
      background: rgba(94, 107, 155, 0.06);
      font-size: 13px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .loading-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--accent-2);
      animation: pulse 0.9s infinite alternate;
    }

    @keyframes pulse {
      from { transform: scale(0.9); opacity: 0.6; }
      to { transform: scale(1.2); opacity: 1; }
    }

    .result-card {
      margin-top: 14px;
      display: none;
      border-radius: var(--radius-card);
      background: var(--card-bg);
      box-shadow: var(--shadow-soft);
      padding: 18px 18px 16px;
    }

    .result-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .result-name {
      font-size: 18px;
      font-weight: 600;
    }

    .result-rating-main {
      font-size: 22px;
      font-weight: 700;
      display: flex;
      align-items: baseline;
      gap: 4px;
    }

    .result-rating-main span {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
    }

    .result-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px 14px;
      font-size: 13px;
      margin-bottom: 10px;
    }

    .result-label {
      font-size: 13px;
      color: var(--text-muted);
    }

    .result-value {
      font-weight: 500;
    }

    .result-explanation {
      font-size: 13px;
      color: var(--text-main);
      padding: 10px 11px;
      border-radius: 12px;
      background: rgba(90, 155, 126, 0.04);
      border: 1px dashed rgba(90, 155, 126, 0.4);
      margin-top: 4px;
    }

    .result-columns {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-top: 10px;
      font-size: 12px;
    }

    .result-column-block {
      border-radius: 12px;
      border: 1px solid rgba(226, 228, 234, 0.9);
      padding: 8px 9px;
      background: rgba(249, 250, 251, 0.9);
    }

    .result-column-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 4px;
      font-weight: 600;
    }

    .result-column-block ul {
      margin: 0;
      padding-left: 16px;
    }

    .result-column-block li {
      margin-bottom: 3px;
    }

    .category-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
      font-size: 12px;
    }

    .category-table th,
    .category-table td {
      padding: 4px 6px;
      border-bottom: 1px solid rgba(226, 228, 234, 0.8);
      text-align: left;
    }

    .category-table th {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
    }

    .back-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
    }

    footer {
      padding: 10px 20px 16px;
      font-size: 12px;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid rgba(226, 228, 234, 0.8);
      background: rgba(249, 249, 251, 0.9);
      backdrop-filter: blur(10px);
    }

    .footer-right {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .footer-right i {
      color: var(--accent-2);
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.35);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 40;
    }

    .modal-backdrop.active {
      display: flex;
    }

    .modal {
      background: var(--card-bg);
      border-radius: 18px;
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.35);
      width: min(720px, 96vw);
      max-height: 80vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      animation: modalIn 0.18s ease-out;
    }

    @keyframes modalIn {
      from { transform: translateY(10px) scale(0.97); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }

    .modal-header {
      padding: 14px 18px 10px;
      border-bottom: 1px solid rgba(226, 228, 234, 0.9);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .modal-title {
      font-size: 16px;
      font-weight: 600;
    }

    .modal-subtitle {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .modal-close {
      border: none;
      background: transparent;
      cursor: pointer;
      border-radius: 999px;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
    }

    .modal-close:hover {
      background: rgba(148, 163, 184, 0.18);
      color: var(--text-main);
      transform: rotate(4deg);
    }

    .modal-body {
      padding: 10px 16px 14px;
      overflow: auto;
    }

    .rating-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .rating-table th,
    .rating-table td {
      padding: 8px 8px;
      text-align: left;
      border-bottom: 1px solid rgba(226, 228, 234, 0.8);
    }

    .rating-table th {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      background: rgba(249, 250, 251, 0.9);
      position: sticky;
      top: 0;
      z-index: 1;
    }

    .rating-table tr:hover td {
      background: rgba(249, 250, 251, 0.9);
    }

    .rating-score {
      font-weight: 600;
    }

    .badge-label {
      padding: 3px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .badge-high {
      background: rgba(34, 197, 94, 0.12);
      color: #15803d;
    }

    .badge-mid {
      background: rgba(59, 130, 246, 0.12);
      color: #1d4ed8;
    }

    .badge-low {
      background: rgba(248, 113, 113, 0.12);
      color: #b91c1c;
    }

    @media (max-width: 768px) {
      header {
        padding: 14px 14px 10px;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
      }

      main {
        padding: 8px 10px 18px;
      }

      .screen.active {
        flex-direction: column;
      }

      .card {
        padding: 18px 16px 16px;
      }

      .hero-title {
        font-size: 22px;
      }

      .hero-subtitle {
        font-size: 13px;
      }

      .screen-main-left,
      .screen-main-right {
        width: 100%;
      }

      .result-grid {
        grid-template-columns: 1fr;
      }

      .btn {
        width: 100%;
        justify-content: center;
      }

      .input-group {
        flex-direction: column;
        align-items: stretch;
      }

      .input-wrapper {
        width: 100%;
      }

      .result-columns {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
<div class="app-shell">
  <header>
    <div>
      <div class="logo">
        <div class="logo-icon">
          <i class="fa-solid fa-music"></i>
        </div>
        <div>
          <div>MusicMatch</div>
          <div class="logo-sub">Аналитика дистрибьюторов</div>
        </div>
      </div>
    </div>
    <div class="header-right">
      <span class="pill">
        <i class="fa-solid fa-brain"></i>
        ML-анализ российских музыкальных дистрибьюторов
      </span>
      <span class="pill">
        <i class="fa-solid fa-chart-line"></i>
        Честный рейтинг 0–100
      </span>
    </div>
  </header>

  <main>
    <!-- ГЛАВНЫЙ ЭКРАН -->
    <section id="screen-main" class="screen active">
      <div class="screen-main-left">
        <div class="card">
          <div class="card-header-label">Добро пожаловать</div>
          <h1 class="hero-title">Анализ российских дистрибьюторов с помощью ML‑модели</h1>
          <p class="hero-subtitle">
            MusicMatch использует ML‑модель, обученную на экспертных оценках, чтобы честно оценивать российских
            дистрибьюторов по выплатам, поддержке, прозрачности и другим факторам.
          </p>

          <div class="hero-actions">
            <button id="btn-go" class="btn btn-primary">
              <i class="fa-solid fa-play"></i>
              GO
            </button>
            <button id="btn-rating" class="btn btn-outline">
              <i class="fa-solid fa-ranking-star"></i>
              РЕЙТИНГ
            </button>
          </div>

          <div class="hero-meta">
            <span><i class="fa-solid fa-circle-nodes"></i> Учитываем: комиссию, выплаты, поддержку, репутацию</span>
            <span><i class="fa-solid fa-gauge-high"></i> Итоговый ML‑рейтинг и оценка</span>
          </div>
        </div>

        <div class="card">
          <div class="card-header-label">Как считается рейтинг</div>
          <div class="metric-grid">
            <div class="metric-chip">
              <i class="fa-solid fa-money-bill-transfer"></i>
              Надёжность и скорость выплат
            </div>
            <div class="metric-chip">
              <i class="fa-solid fa-headset"></i>
              Качество поддержки
            </div>
            <div class="metric-chip">
              <i class="fa-solid fa-file-lines"></i>
              Прозрачность отчётов
            </div>
            <div class="metric-chip">
              <i class="fa-solid fa-bullhorn"></i>
              Промо‑поддержка и продвижение
            </div>
            <div class="metric-chip">
              <i class="fa-solid fa-display"></i>
              Удобство личного кабинета
            </div>
            <div class="metric-chip">
              <i class="fa-solid fa-star-half-stroke"></i>
              Репутация и стабильность релизов
            </div>
          </div>
          <p class="helper-text" style="margin-top:10px;">
            ML‑модель обучена на экспертных оценках по категориям и сама определяет, какие факторы сильнее влияют
            на итоговый рейтинг.
          </p>
        </div>
      </div>

      <div class="screen-main-right">
        <div class="card">
          <div class="card-header-label">Топ дистрибьюторов</div>
          <p class="helper-text">
            Краткий список лидеров по ML‑рейтингу. Полный список доступен по кнопке «РЕЙТИНГ».
          </p>
          <div id="top-list" class="rating-list"></div>
        </div>

        <div class="card">
          <div class="card-header-label">Подсказка</div>
          <p class="helper-text">
            Нажмите «GO», чтобы перейти к детальному анализу конкретного дистрибьютора. Выберите его из списка
            или начните вводить название — поле поддерживает автодополнение.
          </p>
          <button id="btn-go-secondary" class="btn btn-outline" style="margin-top:8px;">
            <i class="fa-solid fa-arrow-right"></i>
            Перейти к анализу
          </button>
        </div>
      </div>
    </section>

    <!-- ЭКРАН АНАЛИЗА -->
    <section id="screen-analysis" class="screen screen-analysis">
      <div class="card">
        <div class="analysis-header">
          <div>
            <div class="card-header-label">Шаг 1</div>
            <div class="analysis-title">Анализ дистрибьютора</div>
          </div>
          <button id="btn-back-main" class="btn btn-ghost">
            <i class="fa-solid fa-arrow-left"></i>
            На главную
          </button>
        </div>
        <p class="analysis-subtitle">
          Выберите дистрибьютора из списка или начните вводить название — система выполнит ML‑анализ и покажет
          честный рейтинг, плюсы, минусы и рекомендации.
        </p>

        <div class="input-group">
          <div class="input-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="distributor-input" class="text-input" list="distributor-list"
                   placeholder="Например, Zvonko Digital" autocomplete="off">
            <datalist id="distributor-list"></datalist>
          </div>
          <button id="btn-analyze" class="btn btn-primary">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            Запустить ML‑анализ
          </button>
        </div>
        <p class="helper-text">
          Если вы введёте неизвестное название, система предложит выбрать дистрибьютора из существующей базы.
        </p>

        <div id="loading-banner" class="loading-banner">
          <div class="loading-dot"></div>
          <span>ML‑модель обрабатывает данные...</span>
        </div>

        <div id="result-card" class="result-card">
          <div class="result-header">
            <div>
              <div class="card-header-label">Результат анализа</div>
              <div id="res-name" class="result-name"></div>
            </div>
            <div>
              <div class="result-rating-main">
                <span id="res-rating">0</span>
                <span>/ 100</span>
              </div>
              <div id="res-label" class="rating-badge rating-badge-mid" style="margin-top:4px;"></div>
            </div>
          </div>

          <div class="result-grid">
            <div>
              <div class="result-label">Год основания</div>
              <div id="res-year" class="result-value"></div>
            </div>
            <div>
              <div class="result-label">Количество артистов</div>
              <div id="res-artists" class="result-value"></div>
            </div>
            <div>
              <div class="result-label">Комиссия</div>
              <div id="res-commission" class="result-value"></div>
            </div>
            <div>
              <div class="result-label">Средний срок выплат</div>
              <div id="res-payout" class="result-value"></div>
            </div>
            <div>
              <div class="result-label">TikTok</div>
              <div id="res-tiktok" class="result-value"></div>
            </div>
            <div>
              <div class="result-label">VK</div>
              <div id="res-vk" class="result-value"></div>
            </div>
          </div>

          <table class="category-table">
            <thead>
              <tr>
                <th>Категория</th>
                <th>Оценка (0–10)</th>
              </tr>
            </thead>
            <tbody id="res-categories"></tbody>
          </table>

          <div class="result-columns">
            <div class="result-column-block">
              <div class="result-column-title">Плюсы</div>
              <ul id="res-pluses"></ul>
            </div>
            <div class="result-column-block">
              <div class="result-column-title">Минусы</div>
              <ul id="res-minuses"></ul>
            </div>
            <div class="result-column-block">
              <div class="result-column-title">Рекомендации</div>
              <ul id="res-recommendations"></ul>
            </div>
          </div>

          <div class="result-explanation" style="margin-top:10px;">
            <span id="res-fit"></span>
          </div>

          <div class="back-row">
            <button id="btn-back-main-bottom" class="btn btn-ghost">
              <i class="fa-solid fa-arrow-left"></i>
              На главный экран
            </button>
            <button id="btn-open-rating-from-result" class="btn btn-outline">
              <i class="fa-solid fa-ranking-star"></i>
              Открыть общий рейтинг
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div>© {{ year }} MusicMatch. Демонстрационный проект анализа дистрибьюторов.</div>
    <div class="footer-right">
      <span><i class="fa-solid fa-shield-heart"></i> Данные условные, для учебных целей.</span>
    </div>
  </footer>
</div>

<!-- МОДАЛЬНОЕ ОКНО РЕЙТИНГА -->
<div id="rating-modal-backdrop" class="modal-backdrop">
  <div class="modal" role="dialog" aria-modal="true">
    <div class="modal-header">
      <div>
        <div class="modal-title">
          <i class="fa-solid fa-ranking-star" style="color:var(--accent-2); margin-right:6px;"></i>
          Рейтинг дистрибьюторов
        </div>
        <div class="modal-subtitle">
          Список отсортирован по ML‑рейтингам от лучшего к худшему.
        </div>
      </div>
      <button id="btn-modal-close" class="modal-close" aria-label="Закрыть">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="modal-body">
      <table class="rating-table">
        <thead>
          <tr>
            <th>Название</th>
            <th>Рейтинг (0–100)</th>
            <th>ML‑оценка</th>
          </tr>
        </thead>
        <tbody id="rating-table-body"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  const distributors = {{ distributors | tojson }};

  const screenMain = document.getElementById('screen-main');
  const screenAnalysis = document.getElementById('screen-analysis');

  const btnGo = document.getElementById('btn-go');
  const btnGoSecondary = document.getElementById('btn-go-secondary');
  const btnBackMain = document.getElementById('btn-back-main');
  const btnBackMainBottom = document.getElementById('btn-back-main-bottom');

  const btnRating = document.getElementById('btn-rating');
  const btnOpenRatingFromResult = document.getElementById('btn-open-rating-from-result');

  const ratingModalBackdrop = document.getElementById('rating-modal-backdrop');
  const btnModalClose = document.getElementById('btn-modal-close');
  const ratingTableBody = document.getElementById('rating-table-body');

  const distributorInput = document.getElementById('distributor-input');
  const distributorList = document.getElementById('distributor-list');
  const btnAnalyze = document.getElementById('btn-analyze');
  const loadingBanner = document.getElementById('loading-banner');
  const resultCard = document.getElementById('result-card');

  const resName = document.getElementById('res-name');
  const resRating = document.getElementById('res-rating');
  const resLabel = document.getElementById('res-label');
  const resYear = document.getElementById('res-year');
  const resArtists = document.getElementById('res-artists');
  const resCommission = document.getElementById('res-commission');
  const resPayout = document.getElementById('res-payout');
  const resTiktok = document.getElementById('res-tiktok');
  const resVk = document.getElementById('res-vk');
  const resCategories = document.getElementById('res-categories');
  const resPluses = document.getElementById('res-pluses');
  const resMinuses = document.getElementById('res-minuses');
  const resRecommendations = document.getElementById('res-recommendations');
  const resFit = document.getElementById('res-fit');

  const topList = document.getElementById('top-list');

  function showScreenMain() {
    screenMain.classList.add('active');
    screenAnalysis.classList.remove('active');
  }

  function showScreenAnalysis() {
    screenMain.classList.remove('active');
    screenAnalysis.classList.add('active');
  }

  btnGo.addEventListener('click', showScreenAnalysis);
  btnGoSecondary.addEventListener('click', showScreenAnalysis);
  btnBackMain.addEventListener('click', showScreenMain);
  btnBackMainBottom.addEventListener('click', showScreenMain);

  function openRatingModal() {
    ratingModalBackdrop.classList.add('active');
  }

  function closeRatingModal() {
    ratingModalBackdrop.classList.remove('active');
  }

  btnRating.addEventListener('click', openRatingModal);
  btnOpenRatingFromResult.addEventListener('click', openRatingModal);
  btnModalClose.addEventListener('click', closeRatingModal);

  ratingModalBackdrop.addEventListener('click', (e) => {
    if (e.target === ratingModalBackdrop) {
      closeRatingModal();
    }
  });

  function labelClass(label) {
    if (label === 'Высокая') return 'badge-high';
    if (label === 'Средняя') return 'badge-mid';
    return 'badge-low';
  }

  function labelClassSmall(label) {
    if (label === 'Высокая') return 'rating-badge rating-badge-high';
    if (label === 'Средняя') return 'rating-badge rating-badge-mid';
    return 'rating-badge rating-badge-low';
  }

  function populateDatalist() {
    distributorList.innerHTML = '';
    distributors.forEach(d => {
      const opt = document.createElement('option');
      opt.value = d.name;
      distributorList.appendChild(opt);
    });
  }

  function populateTopList() {
    const sorted = [...distributors].sort((a, b) => b.rating - a.rating).slice(0, 5);
    topList.innerHTML = '';
    sorted.forEach((d, idx) => {
      const row = document.createElement('div');
      row.className = 'rating-list-row';
      const left = document.createElement('div');
      left.textContent = `${idx + 1}. ${d.name}`;
      const right = document.createElement('div');
      right.innerHTML = `<span class="rating-score">${d.rating}</span>`;
      row.appendChild(left);
      row.appendChild(right);
      topList.appendChild(row);
    });
  }

  function populateRatingTable() {
    const sorted = [...distributors].sort((a, b) => b.rating - a.rating);
    ratingTableBody.innerHTML = '';
    sorted.forEach(d => {
      const tr = document.createElement('tr');

      const tdName = document.createElement('td');
      tdName.textContent = d.name;

      const tdRating = document.createElement('td');
      tdRating.innerHTML = `<span class="rating-score">${d.rating}</span>`;

      const tdLabel = document.createElement('td');
      const span = document.createElement('span');
      span.className = `badge-label ${labelClass(d.ml_label)}`;
      span.innerHTML = `<i class="fa-solid fa-circle"></i> ${d.ml_label}`;
      tdLabel.appendChild(span);

      tr.appendChild(tdName);
      tr.appendChild(tdRating);
      tr.appendChild(tdLabel);

      ratingTableBody.appendChild(tr);
    });
  }

  function setResultCard(d) {
    resName.textContent = d.name;
    resRating.textContent = d.rating;
    resYear.textContent = d.year;
    resArtists.textContent = d.artists;
    resCommission.textContent = d.commission + ' %';
    resPayout.textContent = d.payout_days + ' дней';
    resTiktok.textContent = d.tiktok ? 'Да' : 'Нет';
    resVk.textContent = d.vk ? 'Да' : 'Нет';

    resLabel.textContent = d.ml_label;
    resLabel.className = labelClassSmall(d.ml_label);

    // категории
    resCategories.innerHTML = '';
    const categories = d.scores;
    const names = {
      payouts: 'Надёжность выплат',
      speed: 'Скорость выплат',
      support: 'Поддержка',
      transparency: 'Прозрачность отчётов',
      promo: 'Промо‑поддержка',
      ux: 'Удобство кабинета',
      reputation: 'Репутация',
      stability: 'Стабильность релизов',
    };
    Object.keys(names).forEach(key => {
      const tr = document.createElement('tr');
      const tdName = document.createElement('td');
      const tdScore = document.createElement('td');
      tdName.textContent = names[key];
      tdScore.textContent = categories[key];
      tr.appendChild(tdName);
      tr.appendChild(tdScore);
      resCategories.appendChild(tr);
    });

    // плюсы
    resPluses.innerHTML = '';
    (d.pluses || []).forEach(text => {
      const li = document.createElement('li');
      li.textContent = text;
      resPluses.appendChild(li);
    });

    // минусы
    resMinuses.innerHTML = '';
    (d.minuses || []).forEach(text => {
      const li = document.createElement('li');
      li.textContent = text;
      resMinuses.appendChild(li);
    });

    // рекомендации
    resRecommendations.innerHTML = '';
    (d.recommendations || []).forEach(text => {
      const li = document.createElement('li');
      li.textContent = text;
      resRecommendations.appendChild(li);
    });

    // кому подходит
    resFit.textContent = (d.fit || []).join(' ');

    resultCard.style.display = 'block';
  }

  function showLoading(show) {
    loadingBanner.style.display = show ? 'flex' : 'none';
  }

  async function analyzeDistributor() {
    const name = distributorInput.value.trim();
    if (!name) {
      alert('Введите название дистрибьютора или выберите из списка.');
      return;
    }

    showLoading(true);
    resultCard.style.display = 'none';

    const delay = 500 + Math.random() * 500;
    const delayPromise = new Promise(resolve => setTimeout(resolve, delay));

    const fetchPromise = fetch('/api/analyze', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ name })
    }).then(r => r.json());

    const [data] = await Promise.all([fetchPromise, delayPromise]);

    showLoading(false);

    if (!data.ok) {
      alert('Дистрибьютор не найден. Пожалуйста, выберите из существующего списка.');
      return;
    }

    setResultCard(data.distributor);
  }

  btnAnalyze.addEventListener('click', analyzeDistributor);
  distributorInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      analyzeDistributor();
    }
  });

  populateDatalist();
  populateTopList();
  populateRatingTable();
</script>
</body>
</html>
"""

# ================== FLASK РОУТЫ

@app.route("/")
def index():
    return render_template_string(
        INDEX_HTML,
        distributors=distributors,
        year=datetime.now().year
    )


@app.route("/api/analyze", methods=["POST"])
def api_analyze():
    data = request.get_json(force=True)
    name = (data.get("name") or "").strip().lower()
    dist = None
    for d in distributors:
        if d["name"].lower() == name:
            dist = d
            break

    if dist is None:
        return jsonify({"ok": False})

    result = {
        "name": dist["name"],
        "year": dist["year"],
        "artists": dist["artists"],
        "commission": dist["commission"],
        "payout_days": dist["payout_days"],
        "tiktok": dist["tiktok"],
        "vk": dist["vk"],
        "rating": dist["rating"],
        "ml_label": dist["ml_label"],
        "scores": dist["scores"],
        "pluses": dist["pluses"],
        "minuses": dist["minuses"],
        "recommendations": dist["recommendations"],
        "fit": dist["fit"],
    }
    return jsonify({"ok": True, "distributor": result})


if __name__ == "__main__":
    app.run(debug=True)
