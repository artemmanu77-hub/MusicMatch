# ЧЕСТНЫЙ РЕЙТИНГ НА ОСНОВЕ ML-МОДЕЛИ

def base_overall_from_scores(scores: dict) -> float:
    # честный базовый рейтинг как средневзвешенное по категориям
    # веса: выплаты 20, скорость 15, поддержка 15, прозрачность 10,
    # промо 10, UX 10, репутация 10, стабильность 10
    w = {
        "payouts": 20,
        "speed": 15,
        "support": 15,
        "transparency": 10,
        "promo": 10,
        "ux": 10,
        "reputation": 10,
        "stability": 10,
    }
    total_w = sum(w.values())
    s = 0.0
    for k, weight in w.items():
        s += scores[k] * weight
    # переводим 0–10 в 0–100
    return (s / total_w) * 10.0


def ml_label(score: int) -> str:
    if score >= 80:
        return "Высокая"
    if score >= 50:
        return "Средняя"
    return "Низкая"


def explanation_for(d, score: int, scores: dict) -> dict:
    pluses = []
    minuses = []
    recs = []
    fit = []

    # комиссия
    if d["commission"] <= 12:
        pluses.append("Низкая комиссия делает условия привлекательными.")
    elif d["commission"] > 18:
        minuses.append("Комиссия выше средней по рынку.")

    # выплаты
    if scores["payouts"] >= 8:
        pluses.append("Надёжные и предсказуемые выплаты.")
    elif scores["payouts"] <= 5:
        minuses.append("Есть вопросы к надёжности выплат.")

    # скорость
    if scores["speed"] >= 8:
        pluses.append("Быстрые выплаты — деньги приходят оперативно.")
    elif scores["speed"] <= 5:
        minuses.append("Скорость выплат ниже комфортного уровня.")

    # поддержка
    if scores["support"] >= 8:
        pluses.append("Сильная поддержка: быстро реагируют и помогают.")
    elif scores["support"] <= 5:
        minuses.append("Поддержка может отвечать медленно или формально.")

    # прозрачность
    if scores["transparency"] >= 8:
        pluses.append("Хорошая прозрачность отчётов и понятная аналитика.")
    elif scores["transparency"] <= 5:
        minuses.append("Отчёты могут быть не до конца прозрачными.")

    # промо
    if scores["promo"] >= 8:
        pluses.append("Сильная промо‑поддержка и возможности продвижения.")
    elif scores["promo"] <= 5:
        minuses.append("Промо‑поддержка ограниченная или слабая.")

    # UX
    if scores["ux"] >= 8:
        pluses.append("Удобный личный кабинет и понятный интерфейс.")
    elif scores["ux"] <= 5:
        minuses.append("Интерфейс может быть неудобным или устаревшим.")

    # репутация
    if scores["reputation"] >= 8:
        pluses.append("Хорошая репутация на рынке и доверие артистов.")
    elif scores["reputation"] <= 5:
        minuses.append("Репутация неоднозначная, стоит изучить отзывы.")

    # стабильность
    if scores["stability"] >= 8:
        pluses.append("Стабильная доставка релизов на площадки.")
    elif scores["stability"] <= 5:
        minuses.append("Возможны задержки или нестабильность доставки релизов.")

    # соцсети
    if d["tiktok"] and d["vk"]:
        pluses.append("Хорошее покрытие соцсетей за счёт TikTok и VK.")
    elif not d["tiktok"] and not d["vk"]:
        minuses.append("Нет интеграций с TikTok и VK — слабая соцсеть‑поддержка.")
    else:
        pluses.append("Есть интеграция хотя бы с одной крупной соцсетью.")

    # общая оценка
    if score >= 80:
        recs.append("Подходит как основная платформа для релизов и долгосрочного сотрудничества.")
    elif score >= 60:
        recs.append("Подходит как рабочий вариант, но стоит сравнить с альтернативами.")
    else:
        recs.append("Лучше рассматривать как дополнительный канал или внимательно изучить условия.")

    # кому подходит
    if d["artists"] < 300:
        fit.append("Хороший вариант для независимых артистов и небольших лейблов.")
    elif d["artists"] > 1500:
        fit.append("Подходит крупным лейблам и артистам с большим каталогом.")
    else:
        fit.append("Сбалансированный вариант для артистов среднего уровня и небольших команд.")

    if d["commission"] <= 12:
        fit.append("Особенно интересен тем, кто чувствителен к размеру комиссии.")

    return {
        "pluses": pluses[:4],
        "minuses": minuses[:4],
        "recommendations": recs,
        "fit": fit,
    }


# ОБУЧЕНИЕ ML-МОДЕЛИ

# Фичи: экспертные оценки + базовые параметры
X = []
y = []

for d in distributors:
    s = d["scores"]
    X.append([
        d["commission"],
        d["payout_days"],
        int(d["tiktok"]),
        int(d["vk"]),
        d["artists"],
        d["year"],
        s["payouts"],
        s["speed"],
        s["support"],
        s["transparency"],
        s["promo"],
        s["ux"],
        s["reputation"],
        s["stability"],
    ])
    y.append(base_overall_from_scores(s))

X = np.array(X, dtype=float)
y = np.array(y, dtype=float)

model = RandomForestRegressor(n_estimators=200, random_state=42)
model.fit(X, y)


def model_predict_rating(d):
    s = d["scores"]
    x = np.array([[
        d["commission"],
        d["payout_days"],
        int(d["tiktok"]),
        int(d["vk"]),
        d["artists"],
        d["year"],
        s["payouts"],
        s["speed"],
        s["support"],
        s["transparency"],
        s["promo"],
        s["ux"],
        s["reputation"],
        s["stability"],
    ]], dtype=float)
    pred = float(model.predict(x)[0])
    pred = max(0, min(100, pred))
    return round(pred)


# Предрасчёт рейтингов и текстов
for d in distributors:
    score = model_predict_rating(d)
    d["rating"] = score
    d["ml_label"] = ml_label(score)
    expl = explanation_for(d, score, d["scores"])
    d["pluses"] = expl["pluses"]
    d["minuses"] = expl["minuses"]
    d["recommendations"] = expl["recommendations"]
    d["fit"] = expl["fit"]


